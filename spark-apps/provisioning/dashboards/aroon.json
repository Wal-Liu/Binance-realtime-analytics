        {
          "refId": "B",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT window_start, symbol, aroon_up, aroon_down FROM crypto_aroon WHERE symbol = '$symbol' AND window_start >= $__timeFrom() AND window_start <= $__timeTo() ORDER BY window_start DESC LIMIT 10;"
        }
      ],
      "title": "Latest Aroon Values (Last 10)",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "grafana-postgresql-datasource" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "Uptrend": { "color": "green", "index": 0 },
                "Downtrend": { "color": "red", "index": 1 },
                "Neutral": { "color": "yellow", "index": 2 }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 10 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/.*/"
        },
        "textMode": "value_and_name"
      },
      "pluginVersion": "12.3.0-18701397209",
      "targets": [
        {
          "refId": "C",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN aroon_up > 70 AND aroon_down < 30 THEN 'Uptrend' WHEN aroon_down > 70 AND aroon_up < 30 THEN 'Downtrend' ELSE 'Neutral' END AS status FROM crypto_aroon WHERE symbol = '$symbol' AND $__timeFilter(window_end) ORDER BY window_end DESC LIMIT 1;"
        }
      ],
      "title": "Market Trend (Realtime)",
      "transparent": true,
      "type": "stat"
    }

        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT window_end AS \"time\", adx AS \"ADX\", plus_di AS \"+DI\", minus_di AS \"-DI\" FROM crypto_adx WHERE symbol = '$symbol' ORDER BY window_end;"
        }
      ],
      "title": "ADX Indicator Over Time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "grafana-postgresql-datasource" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "center", "cellOptions": { "type": "auto" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "gray", "value": 0 },
              { "color": "yellow", "value": 25 },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 10 },
      "id": 2,
      "options": { "cellHeight": "sm", "showHeader": true },
      "targets": [
        {
          "refId": "B",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT window_start, symbol, adx, plus_di, minus_di FROM crypto_adx WHERE symbol = '$symbol' AND window_start >= $__timeFrom() AND window_start <= $__timeTo() ORDER BY window_start DESC LIMIT 10;"
        }
      ],
      "title": "Latest ADX Values (Last 10)",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "grafana-postgresql-datasource" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "Strong Uptrend": { "color": "green", "index": 0 },
                "Strong Downtrend": { "color": "red", "index": 1 },
                "Weak Trend": { "color": "yellow", "index": 2 },
                "No Trend": { "color": "gray", "index": 3 }
              }
            }
          ]
        }
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 10 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/" },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "C",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN adx >= 50 AND plus_di > minus_di THEN 'Strong Uptrend' WHEN adx >= 50 AND minus_di > plus_di THEN 'Strong Downtrend' WHEN adx BETWEEN 25 AND 50 THEN 'Weak Trend' ELSE 'No Trend' END AS status FROM crypto_adx WHERE symbol = '$symbol' AND $__timeFilter(window_end) ORDER BY window_end DESC LIMIT 1;"
        }
      ],
      "title": "Market Trend (Realtime by ADX)",
      "transparent": true,
      "type": "stat"
    }
  ],
  "refresh": "auto",
  "schemaVersion": 42,
